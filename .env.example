# =============================================================================
# DiMaac UI — environment
#
# IMPORTANT: every var here is OPTIONAL at runtime.
# With none of them set, the site behaves exactly as it does today:
# templates render from src/data/templateData.ts, zips are read from
# private/templates/, and the admin portal is disabled entirely.
# =============================================================================

# --- Database (Neon Postgres) ------------------------------------------------
# When unset, the site falls back to the static templateData.ts / navigation.ts.
# Get from: Vercel dashboard > Storage > Neon > .env.local tab
DATABASE_URL=

# --- Blob storage (Vercel Blob) — TWO stores, split by who can read ---------
#
# PRIVATE store: template zips. Reads require this token, so a leaked URL is
# useless. The download route streams zips server-side only after the Lemon
# Squeezy licence check passes.
# When unset, downloads fall back to private/templates/*.zip on disk.
BLOB_READ_WRITE_TOKEN=

# PUBLIC store: thumbnails and preview videos. These are rendered by <img> and
# <video> straight from their URL, so they must be world-readable. Never put a
# paid asset in this store.
BLOB_PUBLIC_READ_WRITE_TOKEN=

# --- Admin auth (single user — you) -----------------------------------------
# The admin portal refuses to start unless ALL THREE are set.
# Generate AUTH_SECRET:        openssl rand -base64 32
# Generate ADMIN_PASSWORD_HASH: npm run admin:hash -- 'your-password'
#
# IMPORTANT: in a .env FILE, escape every "$" in the bcrypt hash as \$ —
# dotenv treats "$" as variable expansion and would silently truncate it,
# making every login fail with "incorrect password". Like this:
#   ADMIN_PASSWORD_HASH="\$2b\$12\$abcdef..."
# Values pasted into the Vercel dashboard need NO escaping.
AUTH_SECRET=
ADMIN_EMAIL=
ADMIN_PASSWORD_HASH=

# Host that serves the admin portal. Locally, leave as-is and use /admin.
ADMIN_HOST=admin.dimaac.com

# --- Component publishing (GitHub) ------------------------------------------
# Fine-grained PAT with Contents: read+write on DimaacUI/DiMaac-UI.
# Commits are authored as GITHUB_COMMIT_EMAIL regardless of which account
# the token belongs to.
GITHUB_PAT=
GITHUB_OWNER=DimaacUI
GITHUB_REPO=DiMaac-UI
GITHUB_BRANCH=main
GITHUB_COMMIT_NAME=Joydeb
GITHUB_COMMIT_EMAIL=rjoydeb622@gmail.com

# Vercel deploy hook, fired after a component is committed so the new
# component goes live without you touching the dashboard.
# Create at: Vercel > Project Settings > Git > Deploy Hooks
VERCEL_DEPLOY_HOOK_URL=

# Optional: lets the admin poll build status after triggering a deploy.
VERCEL_API_TOKEN=
VERCEL_PROJECT_ID=

# --- Lemon Squeezy (existing pro gating — unchanged) ------------------------
LEMONSQUEEZY_SUBSCRIPTION_VARIANT_ID=
LEMONSQUEEZY_SUBSCRIPTION_VARIANT_IDS=
LEMONSQUEEZY_WEBHOOK_SECRET=
NEXT_PUBLIC_LEMONSQUEEZY_CHECKOUT_URL=

# --- Analytics ---------------------------------------------------------------
# Set to 0 to disable first-party analytics capture on the public site.
NEXT_PUBLIC_ANALYTICS_ENABLED=1
